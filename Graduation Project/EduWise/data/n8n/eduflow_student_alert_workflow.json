        "language": "javaScript",
        "jsCode": "const result=$input.first().json;\n   const id=result.ok===true && Number.isSafeInteger(result.result?.message_id) ? result.result.message_id : null;\n   return [{json:{status:id ? 'telegram_accepted' : 'delivery_unconfirmed',message_id:id}}];"
      }
