    {
      "id": "dd123456-4234-4234-b234-000000000053",
      "name": "Preview Webhook Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body=$input.first().json.body;\n  if (!body || typeof body!=='object') return [{json:{status:'invalid_payload',preview_only:true}}];\n  const missed=Number(body.missed_sessions_count ?? 0);\n  if (!Number.isSafeInteger(missed) || missed<0 || missed>1000) return [{json:{status:'invalid_attendance',preview_only:true}}];\n  const risk=body.is_at_risk===true || body.is_at_risk===1 || body.is_at_risk==='1';\n  const should_alert=risk || missed>=3;\n  const message=should_alert\n    ? '🔔 EduWise Demo | الطالب التجريبي يحتاج متابعة بسبب '+(risk ? 'مؤشرات الأداء.' : 'الغياب المتكرر.')\n    : '✅ EduWise Demo | البيانات التجريبية لا تستدعي تنبيهاً.';\n  return [{json:{status:'preview',preview_only:true,should_alert,message}}];"
      }
    },
    {
      "id": "dd123456-4234-4234-b234-000000000054",
      "name": "Respond to Demo Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.status === 'preview' ? 200 : 400 }}"
        }
      }
    },
    {
      "id": "dd123456-4234-4234-b234-000000000003",
      "name": "Validate Alert Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nconst scenarios = {\n  absence: { topic: 'attendance', missed: 4, risk: false },\n  risk: { topic: 'academic', missed: 1, risk: true },\n  ok: { topic: 'general', missed: 1, risk: false },\n};\nconst scenario = Object.hasOwn(scenarios, input.scenario) ? input.scenario : 'absence';\nconst selected = scenarios[scenario];\nconst chatId = input.route === 'parent' && typeof input.chat_id === 'string' && /^[1-9][0-9]{0,15}$/.test(input.chat_id) ? input.chat_id : null;\nreturn [{ json: { ...selected, scenario, chat_id: chatId, route: selected.risk || selected.missed >= 3 ? 'alert' : 'skip' } }];"
      }
    },
    {
      "id": "dd123456-4234-4234-b234-000000000004",
