    {
      "id": "dd123456-4234-4234-b234-000000000005",
      "name": "Generate Arabic Parent Message",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        930,
        -220
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3.5-flash-lite"
        },
        "simplify": false,
        "messages": {
