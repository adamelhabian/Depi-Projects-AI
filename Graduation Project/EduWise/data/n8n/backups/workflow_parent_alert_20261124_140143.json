        }
      }
    },
    {
      "parameters": {
        "jsCode": "const demo = $('Validate Alert Input').first().json;\nconst candidate = $input.first().json.candidates?.[0];\nconst code = candidate?.finishReason === 'STOP'\n  ? candidate.content?.parts?.filter(part => !part.thought && typeof part.text === 'string').map(part => part.text).join('').trim()\n  : '';\nconst tips = {\n  ATTENDANCE: 'اتفقوا مع الطالب على تذكير بمواعيد الحصص.',\n  STUDY_PLAN: 'ابدؤوا بموضوع واحد للمراجعة لمدة قصيرة يومياً.',\n  CHECK_IN: 'اسألوا الطالب عن نوع المساعدة اللي يحتاجها.',\n};\nconst expected = demo.topic === 'attendance' ? 'ATTENDANCE' : 'STUDY_PLAN';\nconst usedGemini = code === expected || code === 'CHECK_IN';\nconst reason = demo.risk\n  ? 'مؤشرات الأداء في المثال بتشير إن الطالب يحتاج مراجعة ودعم.'\n  : 'سجّلنا في المثال غياب ' + demo.missed + ' حصص.';\nconst text = [\n  '🔔 تنبيه ولي أمر | EduWise Demo',\n  'الطالب: طالب تجريبي',\n  reason,\n  'خطوة مقترحة: ' + tips[usedGemini ? code : expected],\n].join('\\n');\nreturn [{ json: { text, chat_id: demo.chat_id, status: 'intervention', source: usedGemini ? 'gemini' : 'fallback' } }];"
      },
